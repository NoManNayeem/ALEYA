{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@aleya/game-core": ["./packages/game-core/src/index.ts"],
      "@aleya/renderer-pc": ["./packages/renderer-pc/src/index.ts"],
      "@aleya/audio": ["./packages/audio/src/index.ts"],
      "@aleya/ui": ["./packages/ui/src/index.ts"],
      "@aleya/content-schema": ["./packages/content-schema/src/index.ts"],
      "@content/*": ["./content/*"]
    }
  },
  "include": ["apps/web/src", "packages/*/src", "content", "tests/unit", "vite.config.ts", "vitest.config.ts"]
}
